<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="520.0" prefWidth="800.0" spacing="10.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.desarrollo.proyectohibernateg3.controller.LibroController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <Label text="Registro de libros">
            <font>
                <Font name="System Bold" size="22.0"/>
            </font>
        </Label>
        <GridPane hgap="10.0" vgap="8.0">
            <columnConstraints>
                <ColumnConstraints minWidth="40.0"/>
                <ColumnConstraints prefWidth="160.0"/>
            </columnConstraints>
            <children>
                <Label text="Título:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtTitulo" promptText="Título del libro"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Autor:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtAutor" promptText="Autor del libro"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Año:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtAnio" promptText="Año de publicación"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Precio:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtPrecio" promptText="Precio del libro"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </children>
        </GridPane>
        <HBox spacing="10.0">
            <children>
                <Button fx:id="btnGuardar" text="Guardar libro" onAction="#guardarLibro"/>
                <Button fx:id="btnCargar" text="Cargar libros" onAction="#cargarLibros"/>
                <Button fx:id="btnModificar" text="Modificar libro" onAction="#modificarLibro"/>
                <Button fx:id="btnEliminar" text="Eliminar libro" onAction="#eliminarLibro"/>
                <Button fx:id="btnLimpiar" text="Limpiar campos" onAction="#limpiarCampos"/>
            </children>
        </HBox>
        <TableView fx:id="tablaLibros" prefHeight="300.0" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="Tabla sin contenido"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colId" prefWidth="65.0" text="ID"/>
                <TableColumn fx:id="colTitulo" prefWidth="240.0" text="Título"/>
                <TableColumn fx:id="colAutor" prefWidth="210.0" text="Autor"/>
                <TableColumn fx:id="colAnio" prefWidth="110.0" text="Año"/>
                <TableColumn fx:id="colPrecio" prefWidth="130.0" text="Precio"/>
            </columns>
        </TableView>
    </children>
</VBox>
